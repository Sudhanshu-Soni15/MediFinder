{
  "files.associations": {
    "*.jsp": "html"
  },
  "html.format.enable": false,
  "prettier.disableLanguages": [
    "jsp",
    "html"
  ],
  "[jsp]": {
    "editor.formatOnSave": false,
    "editor.formatOnPaste": false,
    "editor.formatOnType": false
  },
  "[html]": {
    "editor.formatOnSave": false,
    "editor.formatOnPaste": false,
    "editor.formatOnType": false
  }
}
